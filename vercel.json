{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/adopt", "destination": "/Adopt.html" },
    { "source": "/adopt.html", "destination": "/Adopt.html" },
    { "source": "/foster", "destination": "/Foster.html" },
    { "source": "/foster.html", "destination": "/Foster.html" },
    { "source": "/sponsor", "destination": "/Sponsor.html" },
    { "source": "/sponsor.html", "destination": "/Sponsor.html" },
    { "source": "/donate", "destination": "/Donate.html" },
    { "source": "/donate.html", "destination": "/Donate.html" },
    { "source": "/merch", "destination": "/Merch.html" },
    { "source": "/merch.html", "destination": "/Merch.html" },
    { "source": "/news", "destination": "/News.html" },
    { "source": "/news.html", "destination": "/News.html" },
    { "source": "/contact", "destination": "/Contact.html" },
    { "source": "/contact.html", "destination": "/Contact.html" },
    { "source": "/privacy", "destination": "/Privacy.html" },
    { "source": "/privacy.html", "destination": "/Privacy.html" },
    { "source": "/reality", "destination": "/Reality.html" },
    { "source": "/reality.html", "destination": "/Reality.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "run2-rescuedemo.vercel.app" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://unpkg.com 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://new-s3.shelterluv.com https://*.shelterluv.com https://images.unsplash.com https://img.youtube.com https://i.ytimg.com; media-src 'self'; connect-src 'self' https://api.web3forms.com; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com; frame-ancestors 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
      ]
    }
  ]
}
